### Get /
GET http://localhost:5000/
Accept: application/json

### Get all todos
GET http://localhost:5000/api/v1/todos
Accept: application/json

### Get todo by ID
GET http://localhost:5000/api/v1/todos/1
Accept: application/json

### Create a new todo
POST http://localhost:5000/api/v1/todos
Content-Type: application/json

{
  "title": "Title",
  "order": 2
}

### Patch a Todo
PATCH http://localhost:5000/api/v1/todos/1
Content-Type: application/json

[
    {
      "op": "replace",
      "path": "/order",
      "value": 2
    },
    {
      "op": "replace",
      "path": "/title",
      "value": "New Title"
    },
    {
      "op": "replace",
      "path": "/isCompleted",
      "value": true
    }
]

### Delete todo by ID
DELETE http://localhost:5000/api/v1/todos/33

### Delete all Todos
DELETE http://localhost:5000/api/v1/todos/
